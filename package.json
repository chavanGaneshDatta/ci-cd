{
  "name": "my-static-site",
  "version": "1.0.0",
  "description": "Basic HTML/CSS/JS project with CI/CD",
  "scripts": {
    "test": "jest",
    "lint:html": "html-validate index.html",
    "lint:css": "stylelint **/*.css",
    "lint:js": "eslint . --ext .js",
    "format:check": "prettier --check '**/*.{html,css,js,json,md}'",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "ci": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "html-validate": "^8.0.5",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^36.0.0"
  }
}
